# Configuración del entorno - UniMon USB Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Configuración GLPI REST API
GLPI_BASE_URL=https://pruebas.us5.glpi-network.cloud/api.php/v1
GLPI_APP_TOKEN=tu_glpi_app_token_aqui
GLPI_USER_TOKEN=tu_glpi_user_token_aqui

# Configuración Ollama / LLM RAG
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# Configuración ChromaDB y Embeddings
CHROMA_DB_DIR=./chroma_db
DOCS_DIR=./data/docs
EMBEDDING_MODEL=intfloat/multilingual-e5-base
