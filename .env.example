# Configuración del entorno - UniMon USB Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Credenciales del Panel Administrativo (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=UniMonAdmin2026*

# Configuración GLPI REST API
GLPI_BASE_URL=https://tu-instancia.glpi-network.cloud/api.php/v1
GLPI_APP_TOKEN=tu_app_token_aqui
GLPI_USER_TOKEN=tu_user_token_aqui
GLPI_TIMEOUT=15.0

# Configuración de Proveedor LLM (openai | ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=35.0

# Configuración Ollama / LLM Local
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=unimon:8b
VISION_MODEL=llama3.2-vision:11b
OLLAMA_TIMEOUT=45.0
VISION_TIMEOUT=120.0

# Configuración ChromaDB y Embeddings
CHROMA_DB_DIR=./chroma_db
DOCS_DIR=./data/docs
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Límites de Seguridad
MAX_UPLOAD_SIZE_MB=15
