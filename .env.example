# Configuración del entorno - UniMon USB Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Credenciales del Panel Administrativo (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=UniMonAdmin2026*

# Configuración GLPI REST API
GLPI_BASE_URL=https://tu-instancia.glpi-network.cloud/api.php/v1
GLPI_APP_TOKEN=tu_app_token_aqui
GLPI_USER_TOKEN=tu_user_token_aqui
GLPI_TIMEOUT=15.0

# Configuración de Proveedor LLM (gemini | openai | ollama)
LLM_PROVIDER=openai

# Configuración Google Gemini Cloud
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TIMEOUT=35.0

# Configuración OpenAI Cloud
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=35.0

# Configuración Ollama / LLM Local
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=unimon:8b
VISION_MODEL=llama3.2-vision:11b
OLLAMA_TIMEOUT=45.0
VISION_TIMEOUT=120.0

# Configuración ChromaDB y Embeddings
CHROMA_DB_DIR=./chroma_db
DOCS_DIR=./data/docs
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Límites de Seguridad
MAX_UPLOAD_SIZE_MB=15

# ==============================================================================
# LISTA DE OPCIONES PARA LLM_PROVIDER (Copia y pega arriba según desees):
# ==============================================================================
# LLM_PROVIDER=openai     # -> OpenAI Cloud (Modelos: gpt-5.6-luna, gpt-4o, gpt-4o-mini)
# LLM_PROVIDER=gemini     # -> Google Gemini Cloud (Modelos: gemini-flash-lite-latest, gemini-2.0-flash, gemini-1.5-pro)
# LLM_PROVIDER=ollama     # -> Ollama Local (Modelos: unimon:8b, llama3.2:3b, mistral)
# ==============================================================================

